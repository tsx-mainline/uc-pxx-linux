#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""uc-pxx-led: control the LEDs of the UC-P10 through the daemon uc-pxx-leds.

  uc-pxx-led teams|headset|speaker|mic on|off
  uc-pxx-led teams|headset|speaker|mic blink [slow|fast]
  uc-pxx-led status auto
  uc-pxx-led status off
  uc-pxx-led status COLOR [solid|heartbeat]
  uc-pxx-led status COLOR blink [slow|fast]
  uc-pxx-led show

COLOR is red, green, blue, yellow, cyan, magenta or white. The status LED
accepts a command only after the boot is marked good. "status auto" gives it
back to the boot display: green for a short time after a good boot, then off. The user must be root or
in the group of the socket (kiosk).

Exit status: 0 done, 1 the daemon refused the command, 2 wrong usage, 3 the
daemon does not answer.

Environment overrides for tests: UC_PXX_LEDS_SOCK and UC_PXX_LEDS_STATE.
"""

import os
import socket
import sys

RUN = os.environ.get("TSX_RUN_DIR", "/run/tsx")
SOCK = os.environ.get("UC_PXX_LEDS_SOCK", os.path.join(RUN, "uc-pxx-leds.sock"))
STATE = os.environ.get("UC_PXX_LEDS_STATE", os.path.join(RUN, "uc-pxx-leds.state"))
INDICATORS = ("teams", "headset", "speaker", "mic")
USAGE = __doc__.split("COLOR is", 1)[0].strip()


def ask(line):
    """Send one line to the daemon and return its answer, or None."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(3)
    try:
        sock.connect(SOCK)
        sock.sendall((line + "\n").encode("ascii"))
        data = b""
        while True:          # the daemon closes the connection after its answer
            chunk = sock.recv(4096)
            if not chunk:
                break
            data += chunk
    except OSError:
        return None
    finally:
        sock.close()
    return data.decode("ascii", "replace").strip()


def show():
    text = ask("get")
    if text is None:
        try:
            with open(STATE, encoding="ascii", errors="replace") as fobj:
                text = fobj.read().strip()
        except OSError:
            print("uc-pxx-led: the daemon uc-pxx-leds is not running", file=sys.stderr)
            return 3
        print("(the daemon does not answer, this is the last state file)")
    rows = {}
    for line in text.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2:
            rows[parts[0]] = parts[1]
    print("boot      %s" % rows.get("boot", "?"))
    for name in INDICATORS:
        print("%-9s %s" % (name, rows.get(name, "?")))
    print("status    %s (asked: %s)" % (rows.get("shown", "?"), rows.get("status", "?")))
    print("red LED   %s" % rows.get("red", "?"))
    print("persist   %s" % rows.get("persist", "?"))
    return 0


def main(argv):
    if argv in (["-h"], ["--help"], ["help"]):
        print(USAGE)
        return 0
    if argv == ["show"]:
        return show()
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2
    if argv[0] in INDICATORS:
        line = "ind " + " ".join(argv)
    elif argv[0] == "status" and len(argv) > 1:
        line = " ".join(argv)
    else:
        print(USAGE, file=sys.stderr)
        return 2
    if len(line) > 40:
        print(USAGE, file=sys.stderr)
        return 2
    answer = ask(line)
    if answer is None:
        print("uc-pxx-led: the daemon uc-pxx-leds does not answer (%s)" % SOCK, file=sys.stderr)
        return 3
    if answer != "ok":
        print("uc-pxx-led: refused: %s" % answer.replace("err ", "", 1), file=sys.stderr)
        return 2 if answer == "err bad-command" else 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
