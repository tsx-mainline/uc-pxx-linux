#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# uc-pxx-rescue-help: the tools of the rescue system. A login shell prints it
# (/etc/profile.d/uc-pxx-rescue.sh): the shell that Enter opens on the LCD (the
# screen is tsx-rescue-status), the shell on ttyS2 and every ssh login.
echo "UC-P10 rescue system ($(uname -r))"
[ -r /run/rescue-reason ] && echo "why: $(cat /run/rescue-reason)"
echo "  tsx-rescue-status once    show the rescue screen as text"
echo "  uc-pxx-bootctl status     show the A/B state (read only: never mark or arm here)"
echo "  uc-pxx-install-rootfs     write a rootfs.ext4 into system_a (see --help)"
echo "  tsx-data-backup           back up the panel data (see --help)"
echo "  tsx-data-restore          put a backup back (see --help)"
echo "  reboot -f                 boot again (the root file system, if it is there)"
echo "The rescue writes nothing else: boot_a is written on the running system"
echo "with uc-pxx-flash-boot."
