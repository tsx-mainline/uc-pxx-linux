#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# The rescue system of the uc-pxx boot initramfs (busybox init runs this
# script once). It runs from RAM and writes nothing to the eMMC. It reads only
# the six MAC bytes of the cfg partition, and (read only) the login data of the
# root file system. uc-pxx-install-rootfs and tsx-data-restore write to system_a
# only when a person starts them.
#
# Steps:
#   1. Set the backlight (tsx-rescue-backlight, in the background).
#   2. Choose the login (tsx-rescue-login): the root hash and the ssh key of
#      the panel from the root file system, or a one-time password that only
#      the rescue screen shows. Start dropbear (port 22) after it.
#   3. In the background: set the MAC address of eth0 from the cfg partition
#      (bytes 6 to 11, through board.sh), start the RTL8364B switch
#      (rtl8363-init init) while eth0 is down, bring eth0 up and get an
#      address with DHCP.
# The rescue screen (tsx-rescue-status, started by inittab on tty1) shows the
# result. The rescue never marks the boot as good. Slot A stays "trying", so the
# unit falls back to slot B when the tries run out.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
log() {
	echo "uc-pxx-rescue: $*" > /dev/kmsg 2>/dev/null
	echo "uc-pxx-rescue: $*" >> /run/uc-pxx-rescue.log
}
mkdir -p /run /tmp
hostname uc-pxx-rescue
ip link set lo up
log "rescue system: $(cat /run/uc-pxx-rescue-reason 2>/dev/null || echo 'no reason recorded')"
log "shell on ttyS2 (115200). Log: /run/uc-pxx-initramfs.log, /run/uc-pxx-rescue.log"

# The rescue has no tsx-idled. Set the backlight to a moderate level, so it
# does not stay at the boot level.
/usr/sbin/tsx-rescue-backlight > /dev/kmsg 2>&1 &

# The board file: the MAC from the cfg partition, the model from the device tree.
. /usr/local/lib/tsx/board.sh

# The rescue has no fixed password. tsx-rescue-login uses the root hash and the
# ssh key of the panel from the root file system, or makes a one-time password
# that only the rescue screen shows. Dropbear starts after it, so there is no
# moment with a login that nobody chose. The log line never has the password.
# The root file system is on the eMMC already, so the script does not wait
# for a data partition (the unit has none).
TSX_RESCUE_WAIT=0 /usr/sbin/tsx-rescue-login
log "rescue login: $(cat /run/tsx-rescue-login 2>/dev/null || echo failed)"
mkdir -p /etc/dropbear
case $(cat /run/tsx-rescue-login 2>/dev/null) in
none|"") log "no login: dropbear does not start" ;;
*) dropbear -R -E -p 22 -P /run/dropbear.pid 2>> /run/uc-pxx-rescue.log &&
	log "dropbear started on port 22" ;;
esac

net() {
	i=0
	while [ ! -d /sys/class/net/eth0 ] && [ $i -lt 40 ]; do sleep 0.5; i=$((i + 1)); done
	if [ ! -d /sys/class/net/eth0 ]; then
		log "no eth0 (the GMAC driver did not probe)"
		echo "no eth0" > /run/tsx-eth0-mac-src
		return 0
	fi
	# /run/tsx-eth0-mac-src tells the rescue screen that the MAC is final (the
	# board's source name, or random). Until then it shows "starting".
	macsrc=random
	mac=$(tsx_board_mac_early)
	if [ -z "$mac" ]; then
		log "no valid MAC in the cfg partition, eth0 keeps $(cat /sys/class/net/eth0/address)"
	elif ip link set eth0 address "$mac"; then
		macsrc=$(tsx_board_mac_source)
		log "eth0 MAC $mac (from $macsrc)"
	fi
	echo "$macsrc" > /run/tsx-eth0-mac-src
	# The switch init needs eth0 down. The MAC reset of eth0 needs the RGMII
	# clock of the switch.
	i=0
	while ! ls /sys/bus/mdio_bus/drivers/realtek-rtl8364b-smi/*/smi > /dev/null 2>&1 && [ $i -lt 20 ]; do
		sleep 0.5; i=$((i + 1))
	done
	if [ -x /usr/sbin/rtl8363-init ]; then
		timeout 30 /usr/sbin/rtl8363-init init > /run/rtl8363-init.log 2>&1 &&
			log "switch started" || log "rtl8363-init init failed (see /run/rtl8363-init.log)"
	else
		log "no rtl8363-init in this initramfs, the switch stays as it is"
	fi
	ip link set eth0 up || { log "ip link set eth0 up failed"; return 0; }
	udhcpc -i eth0 -b -t 10 -T 3 -x hostname:uc-pxx-rescue \
		-s /usr/share/udhcpc/default.script > /run/udhcpc.log 2>&1
	i=0
	while ! ip -4 addr show dev eth0 | grep -q inet && [ $i -lt 60 ]; do sleep 1; i=$((i + 1)); done
	a=$(ip -4 addr show dev eth0 | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1)
	if [ -z "$a" ]; then log "eth0 has no IPv4 address after 60 s"; return 0; fi
	log "eth0 $a"
}

( net ) &
exit 0
