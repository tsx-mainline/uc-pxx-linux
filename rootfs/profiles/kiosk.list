# Profile "kiosk": console plus the Chromium kiosk on any URL (KIOSK_URL),
# screen blanking, the on-screen keyboard and the setup page. The kiosk owns
# the screen, so this profile has no getty on tty1. Format: see console.list.

pkg seatd
pkg seatd-openrc
pkg sway
pkg swaybg
pkg squeekboard
pkg wvkbd-mobintl
pkg cairo
pkg wayland-libs-client
pkg chromium
pkg font-dejavu
pkg libinput
pkg mesa-dri-gallium
pkg mesa-egl
pkg mesa-gles
pkg mesa-gbm
pkg kmscube
pkg libdrm-tests
pkg mesa-utils
pkg wlr-randr
pkg grim
pkg wayland-utils

svc default seatd
svc default tsx-setup-helper
svc default tsx-setupd
svc default kiosk

user kiosk
user tsx-setup
