#!/sbin/openrc-run
# The RGB status LED shows the boot state (uc-pxx-status-led): blue heartbeat
# while slot A is not marked successful, solid green after that. The program
# runs in the background, polls for up to 10 minutes and stops. It never
# writes the red LED.
description="Status LED: blue heartbeat until the boot is marked good, then green"
command=/usr/local/sbin/uc-pxx-status-led
command_args="run"
command_background=true
pidfile=/run/uc-pxx-status-led.pid
output_log=/var/log/uc-pxx-status-led.log
error_log=/var/log/uc-pxx-status-led.log
depend() { need localmount; after udev-settle; before uc-pxx-boot-ok; }
