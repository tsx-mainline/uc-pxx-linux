#!/bin/sh
# uc-pxx-status-led [run | once]: the RGB status LED shows the boot state.
#
# The LED is three on/off LED class devices in /sys/class/leds: green, red and
# blue. This program uses only green and blue:
#   - Slot A is not marked successful: blue with the heartbeat trigger.
#   - Slot A is marked successful: solid green, blue off.
# It never writes the red LED, and it never turns it off. The boot-control
# scripts light red when the A/B state is unknown (docs/boot-control.md), and
# nothing but a person may clear that.
#
# The state comes from `uc-pxx-bootctl status`. That command only reads the
# A/B sector. It prints "current: A{prio P tries T succ S} B{...}" on standard
# error. S is 1 when the slot is marked successful. The program asks every
# POLL_S seconds for up to LIMIT_S seconds. The hook uc-pxx-mark-boot waits at
# least 60 s after the start of the system, so blue stays on for about that
# long. When the limit ends and the slot is still not marked, blue keeps the
# heartbeat and the program stops (the boot did not end well).
#
#   run    (default) poll until the slot is successful or the limit ends
#   once   look at the state one time, set the LED and exit
#
# The program also writes /run/tsx/status-led.state with one line, "boot ok"
# (slot A is marked successful) or "boot wait" (not yet, or unknown). The root
# helper uc-pxx-leds reads it: Home Assistant may drive the status LED only
# when the line says "boot ok" (docs/leds.md).
#
# Test hooks: UC_PXX_LED_STATE (the state file), UC_PXX_LEDS (the folder of the LED class devices),
# UC_PXX_BOOTCTL (the status program), UC_PXX_LED_POLL_S, UC_PXX_LED_LIMIT_S
# and UC_PXX_LED_SLEEP (the command that waits for POLL_S seconds).
set -u
LEDS=${UC_PXX_LEDS:-/sys/class/leds}
BOOTCTL=${UC_PXX_BOOTCTL:-/usr/sbin/uc-pxx-bootctl}
STATE=${UC_PXX_LED_STATE:-/run/tsx/status-led.state}
POLL_S=${UC_PXX_LED_POLL_S:-10}
LIMIT_S=${UC_PXX_LED_LIMIT_S:-600}
SLEEP=${UC_PXX_LED_SLEEP:-sleep}

log() { echo "uc-pxx-status-led: $*"; }

# led_write LED FILE VALUE: write one LED attribute, quietly
led_write() {
	[ -w "$LEDS/$1/$2" ] || return 1
	{ echo "$3" > "$LEDS/$1/$2"; } 2>/dev/null
}

# slot_state: print "success", "trying" or "unknown". The command does not
# change anything. A failed read is "unknown", not "trying".
slot_state() {
	out=$("$BOOTCTL" status 2>&1) || { echo unknown; return 0; }
	succ=$(printf '%s\n' "$out" | sed -n 's/.*current: A{prio [0-9]* tries [0-9]* succ \([01]\)}.*/\1/p' | head -n 1)
	case $succ in
	1) echo success;;
	0) echo trying;;
	*) echo unknown;;
	esac
}

# put_state ok|wait: tell the boot state in one step (write, then rename)
put_state() {
	mkdir -p "$(dirname "$STATE")" 2>/dev/null
	{ echo "boot $1" > "$STATE.tmp" && chmod 644 "$STATE.tmp" && mv "$STATE.tmp" "$STATE"; } 2>/dev/null || true
}

# show_wait: blue heartbeat, green off. Without the trigger, blue is solid.
show_wait() {
	put_state wait
	led_write green brightness 0
	if ! led_write blue trigger heartbeat; then led_write blue brightness 1; fi
}

# show_ok: solid green, blue off
show_ok() {
	put_state ok
	led_write blue trigger none
	led_write blue brightness 0
	led_write green trigger none
	led_write green brightness 1
}

MODE=${1:-run}
case $MODE in run|once) ;; *) echo "usage: uc-pxx-status-led [run | once]" >&2; exit 2;; esac
[ -d "$LEDS/blue" ] || [ -d "$LEDS/green" ] || { log "no green or blue LED in $LEDS, nothing to do"; exit 0; }

if [ "$MODE" = once ]; then
	case $(slot_state) in success) show_ok;; *) show_wait;; esac
	exit 0
fi

case $POLL_S in ''|*[!0-9]*|0) POLL_S=10;; esac
case $LIMIT_S in ''|*[!0-9]*) LIMIT_S=600;; esac
polls=$(( LIMIT_S / POLL_S )); [ "$polls" -ge 1 ] || polls=1
n=0
show_wait
while :; do
	if [ "$(slot_state)" = success ]; then
		show_ok
		log "slot A is marked successful"
		exit 0
	fi
	n=$((n + 1))
	if [ "$n" -ge "$polls" ]; then
		log "slot A is not marked successful after ${LIMIT_S}s, blue keeps the heartbeat"
		exit 0
	fi
	$SLEEP "$POLL_S"
done
