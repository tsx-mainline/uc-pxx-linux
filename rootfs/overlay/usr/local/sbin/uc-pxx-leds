#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""uc-pxx-leds: the root helper for the LEDs that Home Assistant controls.

The ESPHome plugin of the board (esphome.d/uc-pxx.py) runs as user kiosk when
VOICE is on. That user cannot write the LED class devices and cannot talk to
tsx-buttons. This daemon runs as root. It reads one command per line from a
FIFO that the group kiosk can write, and it does only these fixed commands.
It treats every line as hostile.

  key N on|off|auto      N is 1 to 4, the number of the key LED. The command
                         runs `tsx-keypad key N STATE`. tsx-buttons keeps the
                         override until `auto` or until it restarts.
  keys auto              `auto` for all four key LEDs.
  status R G B           the RGB status LED. R, G and B are 0 or 1.

The status LED. Home Assistant drives it only when both are true:
  1. /run/tsx/status-led.state says "boot ok". The service uc-pxx-status-led
     writes it when slot A is marked successful. Until then the LED shows the
     boot state (blue heartbeat) and this program refuses the command.
  2. The marker /run/uc-pxx-slot-a-changed does not exist. The boot-control
     scripts create it before they change or arm slot A. After that, the LED
     no longer shows a good state, so this program refuses the command.

The red LED. The boot-control scripts light it when the A/B state is unknown.
This program never hides that:
  - If the red LED is on at the start, or it is on and this program did not
    switch it on, the red LED is "latched". This program never writes it
    while it is latched. A status command only changes green and blue.
  - The latch ends only when the red LED reads 0 again, which means that a
    person cleared it.
  - Before it writes the red LED, the program reads it. It writes only when
    the value is the one that it wrote last.

It writes /run/tsx/uc-pxx-leds.state (read by the plugin):
  status ha|boot|locked   who owns the status LED now
  red free|latched

Environment overrides for tests: UC_PXX_LEDS (the LED class folder),
UC_PXX_LEDS_FIFO, UC_PXX_LEDS_STATE, UC_PXX_LED_STATE (the file of
uc-pxx-status-led), UC_PXX_SLOT_MARK, UC_PXX_KEYPAD (the tsx-keypad program),
UC_PXX_LEDS_GROUPS (groups that may write the FIFO, default "kiosk
tsx-panel-app"), UC_PXX_LEDS_TICK and UC_PXX_LEDS_LOOPS.
"""

import grp
import os
import select
import signal
import subprocess
import sys
import time

LEDS = os.environ.get("UC_PXX_LEDS", "/sys/class/leds")
RUN = os.environ.get("TSX_RUN_DIR", "/run/tsx")
FIFO = os.environ.get("UC_PXX_LEDS_FIFO", os.path.join(RUN, "uc-pxx-leds"))
STATE = os.environ.get("UC_PXX_LEDS_STATE", os.path.join(RUN, "uc-pxx-leds.state"))
BOOT_STATE = os.environ.get("UC_PXX_LED_STATE", os.path.join(RUN, "status-led.state"))
SLOT_MARK = os.environ.get("UC_PXX_SLOT_MARK", "/run/uc-pxx-slot-a-changed")
KEYPAD = os.environ.get("UC_PXX_KEYPAD", "tsx-keypad")
GROUPS = os.environ.get("UC_PXX_LEDS_GROUPS", "kiosk tsx-panel-app").split()
TICK = float(os.environ.get("UC_PXX_LEDS_TICK", "1.0"))
KEY_LEDS = 4
MAX_LINE = 64


def log(msg):
    print("uc-pxx-leds: %s" % msg, file=sys.stderr, flush=True)


def clean(text):
    """A line for the log: printable ASCII only, at most 60 characters."""
    return "".join(c if 32 <= ord(c) < 127 else "?" for c in text)[:60]


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fobj:
            return fobj.read().strip()
    except OSError:
        return None


def read_int(path):
    try:
        return int(read_text(path) or "")
    except ValueError:
        return None


def write_text(path, text):
    try:
        with open(path, "w", encoding="utf-8") as fobj:
            fobj.write(text)
        return True
    except OSError:
        return False


class Leds:
    def __init__(self):
        self.red_path = os.path.join(LEDS, "red", "brightness")
        cur = read_int(self.red_path)
        self.red_latched = bool(cur)          # on at the start: not ours
        self.last_red = None if cur else 0    # what this program wrote last
        self.written = None
        self.stop = False

    # ---- who owns the status LED
    def gate(self):
        if os.path.exists(SLOT_MARK):
            return "locked"
        for line in (read_text(BOOT_STATE) or "").splitlines():
            if line.split() == ["boot", "ok"]:
                return "ha"
        return "boot"

    # ---- the red LED
    def red_check(self):
        """Update the latch from what the red LED shows now. Return the value."""
        cur = read_int(self.red_path)
        if cur is None:
            return None
        if self.red_latched:
            if cur == 0:               # a person cleared it
                self.red_latched = False
                self.last_red = 0
        elif cur and self.last_red != 1:
            self.red_latched = True    # lit by somebody else
            log("the red LED was lit by another program: latched, it is never written")
        elif not cur and self.last_red == 1:
            self.last_red = 0          # somebody cleared our red
        return cur

    def write_red(self, want):
        cur = self.red_check()
        if cur is None or self.red_latched:
            return
        if cur != want:
            if write_text(self.red_path, str(want)):
                self.last_red = want

    # ---- commands
    def set_status(self, red, green, blue):
        who = self.gate()
        if who != "ha":
            log("status refused (%s)" % ("the boot is not marked good yet" if who == "boot"
                                          else "slot A was changed in this boot"))
            return False
        self.write_red(red)
        for name, val in (("green", green), ("blue", blue)):
            base = os.path.join(LEDS, name)
            if not os.path.isdir(base):
                continue
            write_text(os.path.join(base, "trigger"), "none")
            write_text(os.path.join(base, "brightness"), str(val))
        return True

    def key(self, number, state):
        try:
            res = subprocess.run([KEYPAD, "key", str(number), state], check=False, timeout=3,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError) as err:
            log("cannot run tsx-keypad: %s" % err)
            return False
        return res.returncode == 0

    def handle(self, line):
        """Run one command line. Return True when it was accepted."""
        words = line.strip()[:MAX_LINE].split()
        if len(line) > MAX_LINE or not all(c.isascii() and c.isprintable() for c in line):
            log("refused (bad line): %s" % clean(line))
            return False
        if len(words) == 3 and words[0] == "key" and words[1] in [str(i) for i in range(1, KEY_LEDS + 1)] \
                and words[2] in ("on", "off", "auto"):
            return self.key(int(words[1]), words[2])
        if words == ["keys", "auto"]:
            return all([self.key(i, "auto") for i in range(1, KEY_LEDS + 1)])
        if len(words) == 4 and words[0] == "status" and all(w in ("0", "1") for w in words[1:]):
            return self.set_status(*[int(w) for w in words[1:]])
        log("refused: %s" % clean(line))
        return False

    # ---- state file
    def publish(self):
        self.red_check()
        text = "status %s\nred %s\n" % (self.gate(), "latched" if self.red_latched else "free")
        if text == self.written:
            return
        tmp = STATE + ".tmp"
        if write_text(tmp, text):
            os.chmod(tmp, 0o644)
            os.replace(tmp, STATE)
            self.written = text


def make_fifo():
    os.makedirs(os.path.dirname(FIFO), mode=0o755, exist_ok=True)
    if not os.path.exists(FIFO):
        os.mkfifo(FIFO, 0o600)
    gid = None
    for name in GROUPS:
        try:
            gid = grp.getgrnam(name).gr_gid
            break
        except KeyError:
            continue
    if gid is not None:
        os.chown(FIFO, -1, gid)       # the owner stays (root when the service runs)
        os.chmod(FIFO, 0o660)
    else:
        os.chmod(FIFO, 0o600)
        log("no group of %s: only root can write %s" % (" ".join(GROUPS), FIFO))


def main():
    if len(sys.argv) > 1:
        print("usage: uc-pxx-leds", file=sys.stderr)
        return 2
    leds = Leds()
    try:
        make_fifo()
        fd = os.open(FIFO, os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as err:
        log("cannot set up %s: %s" % (FIFO, err))
        return 1
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: setattr(leds, "stop", True))
    loops = int(os.environ.get("UC_PXX_LEDS_LOOPS", "0"))
    count = 0
    buf = b""
    log("ready, red LED %s" % ("latched" if leds.red_latched else "free"))
    while not leds.stop and (loops == 0 or count < loops):
        count += 1
        leds.publish()
        end = time.monotonic() + TICK
        while not leds.stop and time.monotonic() < end:
            ready, _, _ = select.select([fd], [], [], max(0.0, min(0.2, end - time.monotonic())))
            if not ready:
                continue
            try:
                buf += os.read(fd, 4096)
            except OSError:
                continue
            while b"\n" in buf:
                raw, buf = buf.split(b"\n", 1)
                leds.handle(raw.decode("utf-8", "replace"))
            if len(buf) > 4096:
                buf = b""
    leds.publish()
    return 0


if __name__ == "__main__":
    sys.exit(main())
